---
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${base}/de/`} />
    <link rel="canonical" href={`${base}/de/`} />
    <title>Wer finanziert die Abstimmungen? / Qui finance les votations ? / Chi finanzia le votazioni?</title>
  </head>
  <body>
    <p>
      <a href={`${base}/de/`}>Deutsch</a> ·
      <a href={`${base}/fr/`}>Français</a> ·
      <a href={`${base}/it/`}>Italiano</a>
    </p>
  </body>
</html>
